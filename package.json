{
  "name": "raccoon-arcade",
  "productName": "Raccoon Arcade",
  "version": "1.0.0",
  "description": "Raccoon Arcade: undici giochi per Mac (Apple Silicon) e Linux.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/run-all.js",
    "screenshots": "node tests/e2e/screenshots.js",
    "build:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "build:mac-zip": "electron-builder --mac zip --arm64 --publish never",
    "build:linux": "electron-builder --linux AppImage tar.gz --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.raccoonarcade.app",
    "productName": "Raccoon Arcade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "artifactName": "RaccoonArcade-${version}-${os}-${arch}.${ext}",
    "linux": {
      "category": "Game",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "synopsis": "Undici giochi da tavolo e da sala giochi",
      "icon": "build/icon.png"
    },
    "afterPack": "build/adhoc-sign.js",
    "dmg": {
      "title": "Raccoon Arcade",
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 420,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 570,
        "height": 380
      }
    }
  },
  "author": "Raccoon Arcade"
}
