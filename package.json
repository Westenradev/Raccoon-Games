{
  "name": "raccoon-arcade",
  "productName": "Raccoon Arcade",
  "version": "1.0.0",
  "description": "Raccoon Arcade: giochi a tema procione per Mac (Apple Silicon).",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:mac": "electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.westenradev.raccoonarcade",
    "productName": "Raccoon Arcade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ]
    }
  }
}
